<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="A Ruby command-line interface (CLI) tool that helps you quickly scaffold new Roda projects">
    <!-- Use the title from a page's frontmatter if it has one -->
    <title><%= current_page.data.title || "Middleman" %></title>
    <link href="https://cdn.jsdelivr.net/npm/beercss@4.0.21/dist/cdn/beer.min.css" rel="stylesheet">
    <script src="
    https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.23/dist/turbo.es2017-umd.min.js
    "></script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/beercss@4.0.21/dist/cdn/beer.min.js"></script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/material-dynamic-colors@1.1.4/dist/cdn/material-dynamic-colors.min.js"></script>

    <%= stylesheet_link_tag "site" %>
    <%= javascript_include_tag "site" %>
  </head>
  <body class="dark">
    <a href="https://github.com/roda-project/roda-project" class="github-sticky-link l m" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path fill="currentColor" d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"></path>
      </svg>
    </a>

    <% ["left max l scroll", "left m scroll", "bottom s scroll"].each do |style| %>
      <nav class="<%= style %>">
        <a href="/" <%= "class='active'" if current_page.url == '/' %>>
          <i>home</i>
          <div>Home</div>
        </a>
        <a href="/project-structure" <%= "class='active'" if current_page.url == '/project-structure/' %>>
          <i>folder_managed</i>
          <div>Project Structure</div>
        </a>
        <a href="/rake-tasks" <%= "class='active'" if current_page.url == '/rake-tasks/' %>>
          <i>terminal</i>
          <div>Rake tasks</div>
        </a>
        <%#
        <a href="/cookbook" < "class='active'" if current_page.url == '/cookbook/' >>
          <i>collections_bookmark</i>
          <div>Cookbook</div>
        </a>
        %>
        <a href="https://roda.jeremyevans.net/documentation.html" target="_blank">
          <i>link_2</i>
          <div>Roda Docs</div>
        </a>
        <a href="https://sequel.jeremyevans.net/index.html" target="_blank">
          <i>link_2</i>
          <div>Sequel Docs</div>
        </a>
      </nav>
    <% end %>

    <main class="responsive">
      <img src="/images/roda-project.png" style="width: 300px;"/>
      <%= yield %>
    </main>
  </body>
</html>
