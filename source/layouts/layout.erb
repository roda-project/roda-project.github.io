<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport"
          content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="A Ruby command-line interface (CLI) tool that helps you quickly scaffold new Roda projects">
    <!-- Use the title from a page's frontmatter if it has one -->
    <title><%= current_page.data.title || "Middleman" %></title>
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
    <script src="
    https://cdn.jsdelivr.net/npm/@hotwired/turbo@8.0.23/dist/turbo.es2017-umd.min.js
    "></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/default.min.css">

    <%= stylesheet_link_tag "docs" %>
    <%= javascript_include_tag "docs" %>
  </head>
  <body>
    <a href="https://github.com/roda-project/roda-project" class="sticky-link left" target="_blank" rel="noopener noreferrer">
      dawd
    </a>
    <a href="https://github.com/roda-project/roda-project" class="sticky-link right" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path fill="currentColor" d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.1-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"></path>
      </svg>
    </a>

    <input type="checkbox" id="menu-toggle" class="menu-toggle-checkbox">
    <label for="menu-toggle" class="sidebar-overlay"></label>
    <header class="mobile-header">
      <label for="menu-toggle" class="hamburger" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </label>
      <div class="mobile-title">Project Docs</div>
    </header>

    <div class="layout-wrapper">
      <nav class="sidebar">
        <div class="sidebar-header">
          <a href="/">
            <img src="/images/roda-project.png" style="width: 100%;"/>
          </a>
        </div>

        <div class="sidebar-content">
          <ul class="menu-sections">
            <li class="menu-section">
              <ul class="section-items">
                <li>
                  <a href="/docs" <%= "class='active'" if current_page.url == '/docs/' %>>
                    <div>Getting Started</div>
                  </a>
                </li>
              </ul>
            </li>

            <li class="menu-section">
              <span class="section-title">Project Structure</span>
              <ul class="section-items">
                <li><a href="#">API / Fullstack</a></li>
                <li><a href="#">Minimal</a></li>
                <li><a href="#">--jeremy</a></li>
              </ul>
            </li>

            <li class="menu-section">
              <span class="section-title">CLI (bin/roda)</span>
              <ul class="section-items">
                <li><a href="#">generators</a></li>
                <li><a href="#">assets</a></li>
                <li><a href="#">dev</a></li>
                <li><a href="#">server</a></li>
                <li><a href="#">db (database)</a></li>
              </ul>
            </li>

            <li class="menu-section">
              <span class="section-title">External Resources</span>
              <ul class="section-items">
                <li>
                  <a href="https://roda.jeremyevans.net/documentation.html" target="_blank">
                    <div>Roda Docs</div>
                  </a>
                </li>
                <li>
                  <a href="https://sequel.jeremyevans.net/documentation.html" target="_blank">
                    <div>Sequel Docs</div>
                  </a>
                </li>
                <li>
                  <a href="https://rodauth.jeremyevans.net/documentation.html" target="_blank">
                    <div>Rodauth Docs</div>
                  </a>
                </li>
              </ul>
            </li>

            <li class="menu-section">
              <span class="section-title">Cheat sheet</span>
              <ul class="section-items">
                <li><a href="#">Authentication</a></li>
                <li><a href="#">CSRF</a></li>
                <li><a href="#">Routing</a></li>
                <li><a href="#">I18n</a></li>
                <li><a href="#">Inertia JS</a></li>
                <li><a href="#">Assets (js / css)</a></li>
              </ul>
            </li>

          </ul>
        </div>
      </nav>

      <main class="main-content">
        <div class="content-container">
          <%= yield %>
        </div>
      </main>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/languages/ruby.min.js"></script>
      <script>hljs.highlightAll();</script>
  </body>
</html>
